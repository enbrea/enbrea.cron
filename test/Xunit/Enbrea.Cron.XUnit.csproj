    <Authors>STÜBER SYSTEMS GmbH</Authors>
    <Company>STÜBER SYSTEMS GmbH</Company>
    <Copyright>© 2026 STÜBER SYSTEMS GmbH</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
